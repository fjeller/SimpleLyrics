@page "/"
@using Fjeller.Convenience.Extensions
@using SimpleLyrics.Components.Dialogs
@using SimpleLyrics.Contracts.Models
@using SimpleLyrics.Contracts.Services
@inject ISongService SongService
@inject IDialogService DialogService
@inject IJSRuntime JsRuntime

<PageTitle>Home</PageTitle>

<SubHeader>

	<FluentButton Appearance="Appearance.Accent" OnClick="AddSong">Add Song</FluentButton>
	<FluentSpacer />
	<FluentButton Appearance="Appearance.Outline">Export Songs</FluentButton>
	<FluentButton Appearance="Appearance.Outline">Import Songs</FluentButton>

</SubHeader>

<PageContent>

	<div class="filter-container">
		<FluentTextField Immediate="true" Appearance="FluentInputAppearance.Filled" Placeholder="Filter items ..." ValueChanged="@(async ( v ) => await FilterChanged( v ))" style="width:100%"></FluentTextField>
	</div>

	<div class="song-grid-container">

		<FluentDataGrid Items="@_songs" GridTemplateColumns="1fr 0.8fr 0.5fr 0.3fr 0.3fr" GenerateHeader="GenerateHeaderOption.Sticky" TGridItem="SongModel" RowSize="@DataGridRowSize.Medium">
			<ChildContent>
				<PropertyColumn Property="@(s => s.Title)" Title="Title" Sortable="true" />
				<PropertyColumn Property="@(s => s.Interpreter)" Title="Interpreter" Sortable="true" />
				<PropertyColumn Property="@(s => s.Category)" Title="Category" Sortable="true" />
				<PropertyColumn Property="@(s => s.Capo)" Title="Capo" Sortable="true" />
				<TemplateColumn Title="Actions">
					<FluentButton Appearance="Appearance.Outline" OnClick="@(async () => await DisplaySong( context ))"><FluentIcon Value="@(new Icons.Regular.Size16.Print())" Color="Color.Accent" /></FluentButton>

					<FluentButton Appearance="Appearance.Outline" OnClick="@(async () => await EditSong( context ))"><FluentIcon Value="@(new Icons.Regular.Size16.Edit())" Color="Color.Accent" /></FluentButton>
					<FluentButton Appearance="Appearance.Outline" OnClick="@(async () => await DeleteSong( context ))"><FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Color="Color.Error" /></FluentButton>
				</TemplateColumn>
			</ChildContent>
			<EmptyContent>
				<FluentLabel Typo="Typography.Body">No Records found</FluentLabel>
			</EmptyContent>
		</FluentDataGrid>
	</div>
</PageContent>

@code {

	private IQueryable<SongModel>? _songs;

	protected override async Task OnInitializedAsync()
	{
		List<SongModel> songs = await SongService.GetSongsAsync( null );
		_songs = songs.AsQueryable();
	}

	private async Task FilterChanged( string? filterValue )
	{
		if ( filterValue.IsEmpty() )
		{
			filterValue = null;
		}

		List<SongModel> songs = await SongService.GetSongsAsync( filterValue );
		_songs = songs.AsQueryable();
	}

	private async Task EditSong( SongModel model )
	{
		IDialogReference dialog = await DialogService.ShowDialogAsync<EditSongDialog>( model, new DialogParameters()
		{
			Height = "auto",
			Width = "1000px",
			Title = "Add Song",
			TrapFocus = true,

			PreventDismissOnOverlayClick = true,
			PreventScroll = true,
		} );

		DialogResult result = await dialog.Result;
		if ( !result.Cancelled && result.Data != null )
		{
			SongModel? resultModel = result.Data as SongModel;
			if ( resultModel is null )
			{
				return;
			}

			await SongService.StoreSong( model );
			List<SongModel> songs = await SongService.GetSongsAsync( null );
			_songs = songs.AsQueryable();
		}
	}

	private async Task AddSong()
	{
		await EditSong( new SongModel() );
	}

	private async Task DisplaySong(SongModel song)
	{
		string url = $"/print/{song.Id}";
		await JsRuntime.InvokeVoidAsync( "open", url, "custom" );
	}

	private async Task DeleteSong(SongModel song)
	{
		string content = $"Are you sure that you want to delete following song:<br /><br />{song.Title} by {song.Interpreter}.<br /><br />This action can not be undone!";

		var dialog = await DialogService.ShowConfirmationAsync(content);
		var result = await dialog.Result;
		if (result.Cancelled)
		{
			return;
		}

		await SongService.DeleteSong( song.Id );
		List<SongModel> songs = await SongService.GetSongsAsync( null );
		_songs = songs.AsQueryable();
	}

}